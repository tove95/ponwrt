# ==============================================================================
# PonWrt ZN504 (Airoha AN7581) Enhanced Release Configuration
# Synthesizing:
# 1. QWRT Recommended: Hardware Crypto (EIP-93), Hardware PPE, 2.5G EN8811H PHY,
#    CPUFreq Scaling, RAMFree, Diskman, TTYD Web Terminal, FileTransfer
# 2. QWRT Optional: Samba4 (KSMBD), WOL Ultra, GecoosAC
# 3. Kahen Project Essence: SoC Thermal Telemetry (/sbin/tempinfo RPC),
#    kmod-mtd-rw, autocore, Footstrap Theme, Simplified Chinese LuCI
# 4. LeoooChen Project Essence: Line-rate PPPoE & XG-PON Flow Offloading,
#    TCP BBR + CAKE Qdisc, 8MB High-Throughput Buffers
# 5. Momo & Sing-Box Ecosystem: Native OpenWrt-momo with Chinese I18n & 128MB GOMEMLIMIT
# ==============================================================================

# ---------------------------------------------------------
# 1. LeoooChen Essence: Line-Rate Offload & Networking Stack
# ---------------------------------------------------------
CONFIG_PACKAGE_kmod-nf-conntrack-bridge=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-bridge=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-dummy=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_mount-utils=y

# ---------------------------------------------------------
# 2. QWRT Essence: Hardware Crypto (SafeXcel EIP-93) & PPE
# ---------------------------------------------------------
# Inside Secure SafeXcel EIP-93 Dedicated Hardware Cryptographic Engine (0x1fb70000)
CONFIG_PACKAGE_kmod-crypto-hw-eip93=y
CONFIG_PACKAGE_kmod-cryptodev=y
CONFIG_PACKAGE_kmod-crypto-aead=y
CONFIG_PACKAGE_kmod-crypto-authenc=y
CONFIG_PACKAGE_kmod-crypto-des=y
CONFIG_PACKAGE_kmod-crypto-ecb=y
CONFIG_PACKAGE_kmod-crypto-gcm=y
CONFIG_PACKAGE_kmod-crypto-seqiv=y
CONFIG_PACKAGE_kmod-crypto-user=y
CONFIG_PACKAGE_kmod-crypto-sha256=y
CONFIG_PACKAGE_kmod-crypto-sha512=y
CONFIG_PACKAGE_kmod-crypto-chacha20poly1305=y

# Airoha AN7581 2.5G PHY (EN8811H) & NPU / PPE Hardware Flow Acceleration
CONFIG_PACKAGE_kmod-phy-airoha-en8811h=y
CONFIG_PACKAGE_airoha-en8811h-firmware=y
CONFIG_PACKAGE_airoha-en7581-npu-firmware=y
CONFIG_PACKAGE_luci-app-airoha-npu=y
CONFIG_BUSYBOX_CONFIG_DEVMEM=y
CONFIG_PACKAGE_luci-app-hqos=y

# ---------------------------------------------------------
# 3. QWRT Recommended: System Tuning & Management Utilities
# ---------------------------------------------------------
# CPU Frequency Scaling & Thermal Control
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_cpufreq=y
CONFIG_PACKAGE_luci-i18n-cpufreq-zh-cn=y

# RAM Free (Memory Cache Cleaner)
CONFIG_PACKAGE_luci-app-ramfree=y
CONFIG_PACKAGE_luci-i18n-ramfree-zh-cn=y

# Disk Management & Storage Partitioner
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y

# Web Terminal (TTYD)
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y

# File Transfer (Web UI Upload & Backup)
CONFIG_PACKAGE_luci-app-filetransfer=y
CONFIG_PACKAGE_luci-i18n-filetransfer-zh-cn=y

# Hardware Inspection & Diagnostics
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_f2fs-tools=y

# ---------------------------------------------------------
# 4. Kahen Essence: Telemetry, Partitions & Interface
# ---------------------------------------------------------
# Read-Write MTD Support for Safe Partition Backup & Calibration Extraction
CONFIG_PACKAGE_kmod-mtd-rw=y

# Autocore System & SoC Telemetry
CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_coremark=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_libudev-zero=y

# UI Themes & Simplified Chinese Localization
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-theme-footstrap=y

# ---------------------------------------------------------
# 5. Momo & Sing-Box Ecosystem (Transparent Proxy Engine)
# ---------------------------------------------------------
CONFIG_PACKAGE_luci-app-momo=y
CONFIG_PACKAGE_momo=y
CONFIG_PACKAGE_sing-box=y

# ---------------------------------------------------------
# 6. IPTV Multicast, Remote Access, DNS & Firewall
# ---------------------------------------------------------
# IPTV Multicast Proxy (msd_lite)
CONFIG_PACKAGE_msd_lite=y
CONFIG_PACKAGE_luci-app-msd_lite=y
CONFIG_PACKAGE_luci-i18n-msd_lite-zh-cn=y

# Cloudflare DDNS
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y

# Lucky (All-in-one Reverse Proxy, DDNS, STUN NAT1)
CONFIG_PACKAGE_lucky=y
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_luci-i18n-lucky-zh-cn=y

# Scheduled Auto-reboot
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y

# Full DNSMASQ (supporting ipset, nftset and DNSSEC)
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y

# NFQUEUE Transparent Redirection
CONFIG_PACKAGE_kmod-nfnetlink-queue=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-ipt-nfqueue=y

# UPnP IGD
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

# ---------------------------------------------------------
# 7. QWRT Optional Features (Pre-configured & Ready to Run)
# ---------------------------------------------------------
# Samba4 / KSMBD File Sharing
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_kmod-fs-ksmbd=y

# WOL Ultra (Wake on LAN Ultra)
CONFIG_PACKAGE_luci-app-wolultra=y
CONFIG_PACKAGE_luci-i18n-wolultra-zh-cn=y

# Gecoos AC (Gecoos AP Controller)
CONFIG_PACKAGE_luci-app-gecoosac=y
CONFIG_PACKAGE_luci-i18n-gecoosac-zh-cn=y
CONFIG_PACKAGE_ucode-mod-rtnl=y
