#!/bin/sh

# 1. 开启网络封包调度加速与基础网络调优（显式禁用网桥 igmp_snooping 确保开机原生放行 IPv6 NDP 邻居发现与 IPTV 组播）
uci -q batch <<EOF
set network.globals.packet_steering='1'
set network.@device[0].igmp_snooping='0'
commit network
EOF

# 1.1 开启 Firewall4 软件流控，禁用硬件 PPE 避免 PPPoE/VLAN 及 IPv6 入站丢包，补全 wan_6 动态接口
uci -q batch <<EOF
set firewall.@defaults[0].flow_offloading='1'
set firewall.@defaults[0].flow_offloading_hw='0'
add_list firewall.@zone[1].network='wan_6'
commit firewall
EOF

# 1.1.1 预置 IPv6 防火墙放行规则（飞牛 NAS 与 Mac Mini）
uci -q batch <<EOF
set firewall.allow_feiniu_nas_ipv6=rule
set firewall.allow_feiniu_nas_ipv6.name='Allow-Feiniu-NAS-IPv6'
set firewall.allow_feiniu_nas_ipv6.src='wan'
set firewall.allow_feiniu_nas_ipv6.dest='lan'
set firewall.allow_feiniu_nas_ipv6.family='ipv6'
set firewall.allow_feiniu_nas_ipv6.proto='tcp udp'
set firewall.allow_feiniu_nas_ipv6.dest_port='21 22 5005 5006 5255 5666 5667 8200 9024 9876'
set firewall.allow_feiniu_nas_ipv6.target='ACCEPT'

set firewall.allow_macmini_ipv6=rule
set firewall.allow_macmini_ipv6.name='Allow-MacMini-IPv6'
set firewall.allow_macmini_ipv6.src='wan'
set firewall.allow_macmini_ipv6.dest='lan'
set firewall.allow_macmini_ipv6.family='ipv6'
set firewall.allow_macmini_ipv6.proto='tcp udp'
set firewall.allow_macmini_ipv6.dest_port='22 2283 6771 8080 8096 8123 9876 21063-21065'
set firewall.allow_macmini_ipv6.target='ACCEPT'
commit firewall
EOF

# 1.2 预置 LuCI 默认主题为 Vantage（与小米 AX3000T 保持一致）
uci -q batch <<EOF
set luci.main.mediaurlbase='/luci-static/vantage'
commit luci
EOF



# 2. 预置 msd_lite 高性能 4K/8K 环形大缓存参数 (8MB 环形接收缓存 + 2MB 预加载加速 + 5s 组播接收超时，接管 port 4022)
if [ -f /etc/config/msd_lite ]; then
    uci -q batch <<EOF
set msd_lite.@instance[0].enabled='1'
del_list msd_lite.@instance[0].address='0.0.0.0:7088'
del_list msd_lite.@instance[0].address='[::]:7088'
add_list msd_lite.@instance[0].address='0.0.0.0:4022'
add_list msd_lite.@instance[0].address='[::]:4022'
set msd_lite.@instance[0].network='lan'
set msd_lite.@instance[0].precache_size='2048'
set msd_lite.@instance[0].ring_buffer_size='8192'
set msd_lite.@instance[0].multicast_recv_buffer_size='2048'
set msd_lite.@instance[0].drop_slow_clients='1'
set msd_lite.@instance[0].threads='4'
set msd_lite.@instance[0].multicast_recv_timeout='5'
commit msd_lite
EOF
fi

if [ -f /etc/config/udpxy ]; then
    uci -q set udpxy.@udpxy[0].disabled='1'
    uci -q commit udpxy
fi

# 2.1 预置 Cloudflare IPv6 DDNS (router.444556.xyz 与 zn504.444556.xyz)
if [ -f /etc/config/ddns ]; then
    uci -q batch <<EOF
set ddns.cf_zn504_ipv6=service
set ddns.cf_zn504_ipv6.enabled='1'
set ddns.cf_zn504_ipv6.service_name='cloudflare.com-v4'
set ddns.cf_zn504_ipv6.domain='zn504@444556.xyz'
set ddns.cf_zn504_ipv6.username='Bearer'
set ddns.cf_zn504_ipv6.password='YOUR_CLOUDFLARE_API_TOKEN'
set ddns.cf_zn504_ipv6.ip_source='interface'
set ddns.cf_zn504_ipv6.ip_interface='br-lan'
set ddns.cf_zn504_ipv6.interface='br-lan'
set ddns.cf_zn504_ipv6.use_ipv6='1'
set ddns.cf_zn504_ipv6.lookup_host='zn504.444556.xyz'
set ddns.cf_zn504_ipv6.check_interval='10'
set ddns.cf_zn504_ipv6.check_unit='minutes'
set ddns.cf_zn504_ipv6.force_interval='24'
set ddns.cf_zn504_ipv6.force_unit='hours'
set ddns.cf_zn504_ipv6.retry_interval='60'
set ddns.cf_zn504_ipv6.retry_unit='seconds'

set ddns.cf_router_ipv6=service
set ddns.cf_router_ipv6.enabled='1'
set ddns.cf_router_ipv6.service_name='cloudflare.com-v4'
set ddns.cf_router_ipv6.domain='router@444556.xyz'
set ddns.cf_router_ipv6.username='Bearer'
set ddns.cf_router_ipv6.password='YOUR_CLOUDFLARE_API_TOKEN'
set ddns.cf_router_ipv6.ip_source='interface'
set ddns.cf_router_ipv6.ip_interface='br-lan'
set ddns.cf_router_ipv6.interface='br-lan'
set ddns.cf_router_ipv6.use_ipv6='1'
set ddns.cf_router_ipv6.lookup_host='router.444556.xyz'
set ddns.cf_router_ipv6.check_interval='10'
set ddns.cf_router_ipv6.check_unit='minutes'
set ddns.cf_router_ipv6.force_interval='24'
set ddns.cf_router_ipv6.force_unit='hours'
set ddns.cf_router_ipv6.retry_interval='60'
set ddns.cf_router_ipv6.retry_unit='seconds'
commit ddns
EOF
fi

# 3. 禁用系统自带独立 sing-box 服务自启（由 momo 独占调度管理，彻底杜绝双进程冲突与端口争抢）
if [ -f /etc/init.d/sing-box ]; then
    /etc/init.d/sing-box disable 2>/dev/null
    /etc/init.d/sing-box stop 2>/dev/null
fi
rm -f /etc/rc.d/S*sing-box 2>/dev/null

# 4. 预置 momo 纯核心模式、128MiB 健康堆内存上限（适配 ZN504 512MB RAM）、IPTV 组播绝对绕行、定时重启与日志自动清理
if [ -f /etc/config/momo ]; then
    uci -q batch <<EOF
set momo.config.core_only='1'
set momo.procd.env_go_mem_limit='128MiB'
set momo.log.scheduled_clear='1'
set momo.log.scheduled_clear_size_limit='1'
set momo.log.scheduled_clear_size_limit_unit='MB'
set momo.log.scheduled_clear_cron='*/5 * * * *'
set momo.config.scheduled_restart='1'
set momo.config.scheduled_restart_cron='0 4 * * *'
add_list momo.proxy.reserved_ip='192.0.0.0/24'
add_list momo.proxy.reserved_ip='224.0.0.0/4'
add_list momo.proxy.reserved_ip='239.0.0.0/8'
commit momo
EOF
fi
mkdir -p /etc/momo/profiles

# 确保热插拔网卡脚本拥有执行权限
chmod +x /etc/hotplug.d/net/99-multicast 2>/dev/null || true
chmod +x /etc/hotplug.d/iface/90-ipv6-fix 2>/dev/null || true
chmod +x /etc/hotplug.d/iface/95-iptv-m3u-ip 2>/dev/null || true

# 首次启动时自动将 /www/iptv.m3u 中的播放地址同步为当前 LAN IP
LAN_IP=$(uci -q get network.lan.ipaddr)
if [ -n "$LAN_IP" ] && [ -f /www/iptv.m3u ]; then
    sed -i "s|http://[0-9.]*:4022/rtp/|http://${LAN_IP}:4022/rtp/|g" /www/iptv.m3u 2>/dev/null
fi

# 5. 优化开机 rc.local：高通量 IPTV UDP 核心参数、网卡队列深度与有线网口组播直通
cat << 'RCLOCAL' > /etc/rc.local
# Put your custom commands here that should be executed once
# the system init finished. By default this file does nothing.

# 1. 若作为旁路由/网桥且缺失 WAN IPv6 默认路由，则自动回退至上游 fe80::1
if ! ip -6 route show default 2>/dev/null | grep -q 'default'; then
    ip -6 route replace default via fe80::1 dev br-lan 2>/dev/null
fi

# 2. 重新加载高通量网络缓冲与 IPTV UDP 核心参数
sysctl -p /etc/sysctl.d/99-custom-net-optimization.conf 2>/dev/null

# 3. 提升核心网桥与网口队列深度为 5000，消除突发高码流丢包
ip link set br-lan txqueuelen 5000 2>/dev/null
for dev in lan1 lan2 lan3 lan4 eth1 pon0; do
    ip link set "$dev" txqueuelen 5000 2>/dev/null
done

# 4. 组播侦听与查询优化，保持网桥组播直通（避免 snooping 拦截 IPv6 NDP 邻居发现与 IPTV 组播）
echo 0 > /sys/devices/virtual/net/br-lan/bridge/multicast_snooping 2>/dev/null
for eth_port in /sys/devices/virtual/net/br-lan/brif/lan* /sys/devices/virtual/net/br-lan/brif/eth* /sys/devices/virtual/net/br-lan/brif/pon*; do
    [ -d "$eth_port" ] && echo 2 > "$eth_port/multicast_router" 2>/dev/null
done

exit 0
RCLOCAL

# 6. ZRAM 内存压缩扩容调优 (zstd 高压缩比算法 + 256MB 稀疏压缩交换区，适配 512MB RAM)
uci set system.@system[0].zram_size_mb='256'
uci set system.@system[0].zram_comp_algo='zstd'
uci commit system

# 7. 每日凌晨 04:30 自动执行 ZRAM 内存空洞压缩整理（紧跟 04:00 momo 定时重启之后），并清理 msd_lite 日志防爆内存
mkdir -p /etc/crontabs
(crontab -l 2>/dev/null | grep -v 'compact'; echo "30 4 * * * echo 1 > /sys/block/zram0/compact 2>/dev/null") | crontab -
(crontab -l 2>/dev/null | grep -v 'msd_lite'; echo '0 2 * * * echo "" > /tmp/log/msd_lite.log 2>/dev/null') | crontab -

# 8. QWRT 经典性能调优：iperf3 测速绑定 Core 3、wget 证书防抖、dnsmasq 降噪
sed -i '/iperf3=/d' /etc/profile 2>/dev/null
echo "alias iperf3='iperf3 -A 3'" >> /etc/profile
echo 'hsts=0' > /root/.wgetrc
sed -i '/log-facility/d' /etc/dnsmasq.conf 2>/dev/null
echo "log-facility=/dev/null" >> /etc/dnsmasq.conf

exit 0
